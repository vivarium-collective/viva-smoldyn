{"id": "viva_smoldyn.composites.reversible-dimerization", "name": "reversible-dimerization", "description": "Smoldyn 3D reversible dimerization: fast red monomers A diffuse and bind pairwise into slower blue dimers B (A + A <-> B) in a reflecting cubic box. Emits per-species counts, per-molecule positions, and time each step \u2014 the positions drive a Simularium trajectory.", "parameters": {}, "state": {"smoldyn": {"_type": "process", "address": "local:SmoldynProcess", "config": {"dimensions": 3, "bounds": [[0, 50], [0, 50], [0, 50]], "boundary_type": "r", "dt": 0.01, "seed": 12345, "species": {"A": {"difc": 3.0, "count": 250, "color": "red", "display_size": 1.2}, "B": {"difc": 1.0, "count": 0, "color": "blue", "display_size": 2.0}}, "reactions": [{"name": "dimerize", "subs": ["A", "A"], "prds": ["B"], "rate": 2.0, "kb": 0.15}]}, "inputs": {}, "outputs": {"molecule_counts": ["molecule_counts"], "molecule_positions": ["molecule_positions"], "time": ["time"]}, "interval": 0.5}, "molecule_counts": {}, "molecule_positions": [], "time": 0.0, "_declared_emit_paths": ["molecule_counts", "molecule_positions", "time"]}, "schema": {}, "overrides": {}, "requires": {"processes": ["SmoldynProcess"]}, "tags": ["particles", "reaction-diffusion", "3d", "simularium"], "visualizations": [], "analyses": [], "emitters": [{"address": "local:ParquetEmitter", "paths": ["molecule_counts", "molecule_positions", "time"]}], "kind": "spec", "module": "", "default_n_steps": null, "svg": null, "wiring_status": "ready", "run_kind": "temporal", "notice": null}