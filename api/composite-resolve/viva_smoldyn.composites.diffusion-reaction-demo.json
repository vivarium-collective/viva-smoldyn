{"id": "viva_smoldyn.composites.diffusion-reaction-demo", "name": "diffusion-reaction-demo", "description": "Tiny Smoldyn diffusion-reaction demo: species A (fast) diffuses and converts to species B (slow) via a first-order reaction in a 2D reflecting box. Emits per-species molecule counts and simulation time each step.", "parameters": {"interval": {"type": "float", "default": 5.0, "description": "Process interval in simulation time units. Each update advances Smoldyn via runUntil() by this amount."}, "dt": {"type": "float", "default": 0.01, "description": "Smoldyn internal timestep."}, "count_a": {"type": "integer", "default": 200, "description": "Initial count of species A."}, "count_b": {"type": "integer", "default": 0, "description": "Initial count of species B."}, "rate_ab": {"type": "float", "default": 0.01, "description": "First-order reaction rate constant for A -> B."}}, "state": {"smoldyn": {"_type": "process", "address": "local:SmoldynProcess", "config": {"dimensions": 2, "bounds": [[0, 100], [0, 100]], "boundary_type": "r", "dt": 0.01, "seed": 12345, "species": {"A": {"difc": 1.0, "count": 200, "color": "red", "display_size": 3}, "B": {"difc": 0.3, "count": 0, "color": "blue", "display_size": 3}}, "reactions": [{"name": "convert", "subs": ["A"], "prds": ["B"], "rate": 0.01}]}, "inputs": {}, "outputs": {"molecule_counts": ["stores", "molecule_counts"], "time": ["stores", "time"]}, "interval": 5.0}, "stores": {"molecule_counts": {}, "time": 0.0}, "emitter": {"_type": "step", "address": "local:ram-emitter", "config": {"emit": {"molecule_counts": "map[integer]", "time": "float"}}, "inputs": {"molecule_counts": ["stores", "molecule_counts"], "time": ["stores", "time"]}}}, "schema": {}, "overrides": {}, "requires": {"processes": ["SmoldynProcess", "RAMEmitter"]}, "tags": ["particles", "reaction-diffusion", "demo"], "visualizations": [], "analyses": [], "emitters": [], "kind": "spec", "module": "", "default_n_steps": null, "svg": null, "wiring_status": "ready", "run_kind": "temporal", "notice": null}